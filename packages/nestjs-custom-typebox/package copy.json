{
	"packageManager": "pnpm@10.4.1",
	"volta": {
		"node": "20.18.1"
	},
	"name": "nestjs-custom-typebox",
	"version": "0.0.1",
	"description": "",
	"author": "mklx1319@gmail.com",
	"private": true,
	"sideEffects": false,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "20.x"
	},
	"files": ["dist"],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"typesVersions": {
		"*": {
			"*": ["dist/*", "dist/*/index"]
		}
	},
	"publishConfig": {
		"typesVersions": {
			"*": {
				"*": ["dist/*.d.ts", "dist/*/index.d.ts"]
			}
		}
	},
	"scripts": {
		"build": "rm -fr dist/* && tsc",
		"lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
		"clean": "rm -rf .turbo",
		"clean-all": "rm -rf .turbo && rm -rf node_modules"
	},
	"peerDependencies": {
		"@nestjs/common": "^9.0.1 || ^10.0.3",
		"@nestjs/core": "^9.0.1 || ^10.0.3",
		"@nestjs/swagger": "^6.1.1 || ^7.0.11 || ^8.1.0",
		"@sinclair/typebox": "^0.34.0",
		"rxjs": "^7.8.0"
	},
	"devDependencies": {
		"@nestjs/common": "^10.4.15",
		"@nestjs/core": "^10.4.15",
		"@nestjs/swagger": "^8.1.0",
		"@sinclair/typebox": "^0.34.13"
	}
}

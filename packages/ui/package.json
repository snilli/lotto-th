{
	"name": "@snilli/ui",
	"version": "0.0.1",
	"repository": "https://github.com/vercel/examples.git",
	"license": "MIT",
	"private": true,
	"scripts": {
		"lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
		"clean": "rm -rf .turbo",
		"clean-all": "rm -rf .turbo && rm -rf node_modules",
		"build": "rm -fr dist/* && tsc"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./tailwind": "./src/tailwind.config.ts"
	},
	"files": [
		"src"
	],
	"typesVersions": {
		"*": {
			"*": [
				"src/*",
				"src/*/index"
			]
		}
	},
	"peerDependencies": {
		"react": "^17.0.0 || ^18.0.0-0 || ^19.0.0-0",
		"react-dom": "^17.0.0 || ^18.0.0-0 || ^19.0.0-0"
	},
	"dependencies": {
		"clsx": "^2.1.1"
	}
}

{
  "compilerOptions": {
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES6",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "paths": {
      "@app": [
        "src"
      ],
      "@app/*": [
        "src/*"
      ],
      "@app/drizzle": [
        "libs/drizzle/src"
      ],
      "@app/drizzle/*": [
        "libs/drizzle/src/*"
      ],
      "@app/lotto-client": [
        "libs/lotto-client/src"
      ],
      "@app/lotto-client/*": [
        "libs/lotto-client/src/*"
      ],
      "@app/pokemon-name": [
        "libs/pokemon-name/src"
      ],
      "@app/pokemon-name/*": [
        "libs/pokemon-name/src/*"
      ],
      "@app/time": [
        "libs/time/src"
      ],
      "@app/time/*": [
        "libs/time/src/*"
      ]
    }
  },
  "exclude": [
    "src/lotto/schema/index.ts",
  ]
}
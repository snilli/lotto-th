{
	"packageManager": "pnpm@9.15.2",
	"volta": {
		"node": "20.18.1"
	},
	"name": "lotto-api",
	"version": "0.0.1",
	"description": "thailand lotto history",
	"author": "mklx1319@gmail.com",
	"private": true,
	"license": "UNLICENSED",
	"main": "dist/main.js",
	"engines": {
		"node": "20.x"
	},
	"type": "commonjs",
	"scripts": {
		"migration:gen": "drizzle-kit generate",
		"migration:apply": "drizzle-kit migrate",
		"migration:drop": "drizzle-kit drop",
		"build": "nest build",
		"build:bun": "bun build --external=class-transformer --external=class-validator --external=@nestjs/microservices --external=@nestjs/websockets --target=bun --minify ./apps/backend/dist/main.js --outdir=apps/backend/dist --format esm ./apps/backend/src/main.ts",
		"build:bun-bin": "bun build --compile --external=class-transformer --external=class-validator --external=@nestjs/microservices --external=@nestjs/websockets --target=bun-linux-arm64 --minify ./apps/backend/src/main.ts --outfile=apps/backend/dist/main",
		"migration:fetch": "drizzle-kit generate",
		"a": "drizzle-kit pull",
		"build:migration": "nest build migration",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
		"start": "nest start",
		"dev": "nest start --watch",
		"start:migrate": "node dist/cli/main-cli.js migrate --dir $(pwd)/drizzle",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"lint-all": "eslint \"{src,apps,libs,test}/**/*.spec.ts\" --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --inspect --logHeapUsage --poolOptions.threads.singleThread",
		"test:e2e": "vitest run --config ./test/vitest.config.e2e.ts",
		"clean": "rm -rf ./dist && rm -rf .turbo",
		"clean-all": "rm -rf ./dist && rm -rf .turbo && rm -rf node_modules",
		"deploy": "wrangler deploy --node-compat --minify out/main.js",
		"deploy2": "wrangler deploy --minify src/main.ts",
		"deploy3": "wrangler deploy dist/main.js"
	},
	"dependencies": {
		"@codegenie/serverless-express": "^4.16.0",
		"@nestjs/axios": "^3.1.3",
		"@nestjs/cache-manager": "^2.3.0",
		"@nestjs/common": "^10.4.15",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.4.15",
		"@nestjs/platform-express": "^10.4.15",
		"@nestjs/swagger": "^8.1.0",
		"@sinclair/typebox": "^0.34.13",
		"@types/aws-lambda": "^8.10.147",
		"@vercel/postgres": "^0.10.0",
		"agentkeepalive": "^4.6.0",
		"axios": "^1.7.9",
		"cheerio": "1.0.0-rc.12",
		"compression": "^1.7.5",
		"dayjs": "^1.11.13",
		"drizzle-orm": "^0.38.3",
		"drizzle-typebox": "^0.2.1",
		"express": "^5.0.1",
		"nest-commander": "^3.15.0",
		"nestjs-typebox": "^3.1.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.4.9",
		"@nestjs/schematics": "^10.2.3",
		"@nestjs/testing": "^10.4.15",
		"@swc/cli": "^0.5.2",
		"@swc/core": "^1.10.4",
		"@swc/helpers": "^0.5.15",
		"@types/compression": "^1.7.5",
		"@types/express": "^4.17.21",
		"@types/node": "^20.17.11",
		"@types/supertest": "^6.0.2",
		"@typescript-eslint/eslint-plugin": "^8.19.0",
		"@typescript-eslint/parser": "^8.19.0",
		"@vitest/coverage-v8": "^2.1.8",
		"dotenv": "^16.4.7",
		"drizzle-kit": "^0.30.1",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-prettier": "^5.2.1",
		"prettier": "^3.4.2",
		"supertest": "^7.0.0",
		"swc-loader": "^0.2.6",
		"typescript": "^5.7.2",
		"unplugin-swc": "^1.5.1",
		"vite": "^5.4.11",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^2.1.8"
	}
}

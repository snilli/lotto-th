{
	"packageManager": "pnpm@10.11.1",
	"volta": {
		"node": "22.16.0",
		"pnpm": "10.11.1"
	},
	"name": "lotto-api",
	"version": "0.0.1",
	"description": "thailand lotto history",
	"author": "mklx1319@gmail.com",
	"private": true,
	"license": "UNLICENSED",
	"main": "dist/main.js",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"migration:gen": "drizzle-kit generate",
		"migration:apply": "drizzle-kit migrate",
		"migration:drop": "drizzle-kit drop",
		"build": "nest build --webpack",
		"migration:fetch": "drizzle-kit generate",
		"a": "drizzle-kit pull",
		"build:migration": "nest build migration",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
		"start": "nest start",
		"dev": "nest start --watch default",
		"start:migrate": "node dist/cli/main-cli.js migrate --dir $(pwd)/drizzle",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"lint-all": "eslint \"{src,apps,libs,test}/**/*.spec.ts\" --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --inspect --logHeapUsage --poolOptions.threads.singleThread",
		"test:e2e": "vitest run --config ./test/vitest.config.e2e.ts",
		"clean": "rm -rf dist && rm -rf .turbo",
		"clean-all": "rm -rf dist && rm -rf .turbo && rm -rf node_modules"
	},
	"dependencies": {
		"@codegenie/serverless-express": "^4.16.0",
		"@nestjs/axios": "^4.0.0",
		"@nestjs/cache-manager": "^3.0.1",
		"@nestjs/common": "^11.1.3",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.3",
		"@nestjs/platform-express": "^11.1.3",
		"@nestjs/swagger": "^11.2.0",
		"@types/aws-lambda": "^8.10.149",
		"@vercel/postgres": "^0.10.0",
		"agentkeepalive": "^4.6.0",
		"axios": "^1.9.0",
		"cheerio": "1.0.0",
		"compression": "^1.8.0",
		"dayjs": "^1.11.13",
		"drizzle-orm": "^0.44.2",
		"drizzle-zod": "^0.8.2",
		"express": "^5.1.0",
		"nest-commander": "^3.17.0",
		"nestjs-zod": "next",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^3.25.46"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.7",
		"@nestjs/schematics": "^11.0.5",
		"@nestjs/testing": "^11.1.2",
		"@swc/core": "^1.11.29",
		"@types/compression": "^1.8.0",
		"@types/express": "^5.0.2",
		"@types/supertest": "^6.0.3",
		"@vitest/coverage-v8": "^3.1.4",
		"domelementtype": "^2.3.0",
		"domhandler": "^5.0.3",
		"dotenv": "^16.5.0",
		"drizzle-kit": "^0.30.6",
		"eslint-plugin-drizzle": "^0.2.3",
		"supertest": "^7.1.1",
		"swc-loader": "^0.2.6",
		"ts-loader": "^9.5.2",
		"unplugin-swc": "^1.5.4",
		"vite-tsconfig-paths": "^5.1.4"
	}
}

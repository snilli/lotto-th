{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src/app",
  "entryFile": "http-server",
  "plugins": [
    "@nestjs/swagger"
  ],
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": ".swcrc"
      }
    },
    "typeCheck": true,
    "webpackConfigPath": "./webpack.config.js",
    "webpack": true
  },
  "projects": {
    "dev2": {
      "type": "application",
      "entryFile": "http-server2"
    },
    "drizzle": {
      "type": "library",
      "root": "libs/drizzle",
      "entryFile": "index",
      "sourceRoot": "libs/drizzle/src",
      "compilerOptions": {
        "tsConfigPath": "libs/drizzle/tsconfig.lib.json"
      }
    },
    "lotto-client": {
      "type": "library",
      "root": "libs/lotto-client",
      "entryFile": "index",
      "sourceRoot": "libs/lotto-client/src",
      "compilerOptions": {
        "tsConfigPath": "libs/lotto-client/tsconfig.lib.json"
      }
    },
    "migration": {
      "type": "application",
      "compilerOptions": {
        "tsConfigPath": "./tsconfig.cli.json"
      },
      "entryFile": "main-cli"
    },
    "pokemon-name": {
      "type": "library",
      "root": "libs/pokemon-name",
      "entryFile": "index",
      "sourceRoot": "libs/pokemon-name/src",
      "compilerOptions": {
        "tsConfigPath": "libs/pokemon-name/tsconfig.lib.json"
      }
    },
    "time": {
      "type": "library",
      "root": "libs/time",
      "entryFile": "index",
      "sourceRoot": "libs/time/src",
      "compilerOptions": {
        "tsConfigPath": "libs/time/tsconfig.lib.json"
      }
    }
  }
}
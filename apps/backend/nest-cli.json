{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"plugins": ["@nestjs/swagger"],
	"compilerOptions": {
		"deleteOutDir": true,
		"builder": {
			"type": "swc",
			"options": {
				"swcrcPath": ".swcrc"
			}
		},
		"webpackConfigPath": "webpack.config.js",
		"typeCheck": true,
		"webpack": true
	},
	"projects": {
		"default": {
			"type": "application",
			"entryFile": "server"
		},
		"lotto-client": {
			"type": "library",
			"root": "libs/lotto-client",
			"entryFile": "index",
			"sourceRoot": "libs/lotto-client/src",
			"compilerOptions": {
				"tsConfigPath": "libs/lotto-client/tsconfig.lib.json"
			}
		},
		"migration": {
			"type": "application",
			"compilerOptions": {
				"tsConfigPath": "./tsconfig.cli.json"
			},
			"entryFile": "main-cli"
		}
	}
}
